# Copy to .env (untracked) before running --live-gcp provisioning or queries.
PROJECT_ID="example-project-id"
BQ_LOCATION="asia-southeast1"
DATASET_ID="meridian_commerce"
PACK_ID="meridian_q3_sgd"
EVAL_RUNS="5"

# Optional Role-SA map JSON for live BigQuery RLS impersonation in Beat 4b:
# SQL_ROLE_SA_MAP_JSON='{"cfo_regional":"cfo-regional@example-project-id.iam.gserviceaccount.com","sg_coldchain":"sg-coldchain@example-project-id.iam.gserviceaccount.com"}'

# Optional Cloud Run live deployment settings (scripts/deploy_cloud_run.sh):
SERVICE_NAME="context-is-all-you-need"
BQ_MAX_BYTES_BILLED="104857600"
RUN_RUNG_RPM_LIMIT="30"
